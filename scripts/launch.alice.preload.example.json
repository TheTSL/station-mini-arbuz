                    "order": 1,
                    "log": false
                },
                {
                    "name": "mediad",
                    "delay": 5,
                    "allowedRestartIntervalSeconds": 600,
                    "root": ".",
                    "path": "/system/vendor/quasar/maind",
                    "arg": ["--mediad"],
                    "envs": ["MALLOC_ARENA_MAX=2", "CA_CERTIFICATES=/system/vendor/quasar/ca-certificates.crt", "LD_PRELOAD=/data/opt/libi2clog.so"],
                    "order": 3,
                    "log": false
                }
            ]
        }
    ]
}
