{
    "nodes": [
        {
            "name": "main",
            "root": ".",
            "tasks": [
                {
                    "name": "maind",
                    "delay": 5,
                    "allowedRestartIntervalSeconds": 10,
                    "root": ".",
                    "path": "/system/vendor/quasar/maind",
